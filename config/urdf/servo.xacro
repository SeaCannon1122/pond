<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="servo_x" value="0.0455"/>
    <xacro:property name="servo_y" value="0.025"/>
    <xacro:property name="servo_z" value="0.035"/>


    <xacro:macro name="servo" params="name flipped">

        <link name="${name}">
            <visual>
                <origin xyz="-0.011375 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${servo_x} ${servo_y} ${servo_z}" />
                </geometry>
                <material name="black" />
            </visual>
            <collision>
                <origin xyz="-0.011375 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${servo_x} ${servo_y} ${servo_z}" />
                </geometry>
            </collision>
            <xacro:inertial_box mass="0.1" x="${servo_x}" y="${servo_y}" z="${servo_z}">
                <origin xyz="-0.011375 0 0" rpy="0 0 0" />
            </xacro:inertial_box>
        </link>

        <link name="${name}_axis">
            <visual>
                <geometry>
                    <cylinder radius="0.002" length="0.08" />
                </geometry>
                <material name="yellow" />
            </visual>
            <xacro:inertial_cylinder mass="0.1" length="0.08" radius="0.002">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <joint name="${name}_joint" type="continuous">

            <xacro:unless value="${flipped}">
                <parent link="${name}" />
                <child link="${name}_axis" />
            </xacro:unless>
            
            <xacro:if value="${flipped}">
                <parent link="${name}_axis" />
                <child link="${name}" />
            </xacro:if>
            
            <axis xyz="0 0 1" />
        </joint>

    </xacro:macro>

</robot>