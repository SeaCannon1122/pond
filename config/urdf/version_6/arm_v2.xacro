<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="gripper.xacro" />

    <material name="arm_material">
        <color rgba="0.7 0.7 0.7 1.0" />
    </material>

    <joint name="arm_segment_0_joint" type="continuous">
        <parent link="chassis"/>
        <child link="arm_segment_0"/>
        <origin xyz="0.15 0 0.0445" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 1" />
    </joint>

    <link name="arm_segment_0">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.2"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
            <geometry>
                <mesh filename="package://quac/meshes/version_6/arm_v2/arm_segment_0_reduced.stl" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
            </geometry>
            <material name="arm_material"/>
        </visual>
    </link>

    <joint name="arm_segment_1_joint" type="continuous">
        <parent link="arm_segment_0"/>
        <child link="arm_segment_1"/>
        <origin xyz="-0.1 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1" />
    </joint>

    <link name="arm_segment_1">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.2"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
        <visual>
            <origin xyz="-0.02 0.05 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <mesh filename="package://quac/meshes/version_6/arm_v2/arm_segment_1_reduced.stl" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
            </geometry>
            <material name="arm_material"/>
        </visual>
    </link>

    <joint name="arm_segment_2_joint" type="continuous">
        <parent link="arm_segment_1"/>
        <child link="arm_segment_2"/>
        <origin xyz="-0.02 0.05 0" rpy="0 0 0"/>
        <axis xyz="0 0 1" />
    </joint>

    <link name="arm_segment_2">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.2"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
            <geometry>
                <mesh filename="package://quac/meshes/version_6/arm_v2/arm_segment_2_reduced.stl" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
            </geometry>
            <material name="arm_material"/>
        </visual>
    </link>

    <joint name="gripper_base_joint" type="fixed">
        <parent link="arm_segment_2" />
        <child link="gripper_base" />
        <origin xyz="0.066 -0.0155 -0.0002 " rpy="${-pi/2} 0 0"/>
        <axis xyz="0 0 1" />
    </joint>
    
</robot>