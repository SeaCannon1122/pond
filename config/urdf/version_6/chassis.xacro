<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="arm_v2.xacro" />
    <xacro:include filename="wheels.xacro" />

    <material name="chassis_material">
        <color rgba="1.0 1.0 1.0 1.0" />
    </material>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0.13" rpy="0 0 0"/>
    </joint>

    <link name="chassis">
        <xacro:inertial_box mass="2.5" x="0.31" y="0.12" z="0.07">
            <origin xyz="0 0 -0.005" rpy="0 0 0"/>
        </xacro:inertial_box>
        <!-- <collision>
            <origin xyz="0 0 -0.005" rpy="0 0 0"/>
            <geometry>
                <box size="0.31 0.12 0.07" />
            </geometry>
        </collision>
        <collision>
            <origin xyz="-0.055 0 0.06" rpy="0 0 0"/>
            <geometry>
                <box size="0.13 0.16 0.06" />
            </geometry>
        </collision> -->
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_folder}version_6/chassis_reduced.stl" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
            </geometry>
            <material name="chassis_material"/>
        </collision>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_folder}version_6/chassis_reduced.stl" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
            </geometry>
            <material name="chassis_material"/>
        </visual>
    </link>

    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser"/>
        <origin xyz="-0.035 0.0 0.127" rpy="0 0 ${-pi/2}"/>
    </joint>

    <link name="laser"/>
    
    <xacro:sensor_d435 parent="chassis" name="camera_back" use_nominal_extrinsics="true">
        <origin xyz="-0.09 0.0 0.09" rpy="0 0 ${pi}"/>
    </xacro:sensor_d435>

	<xacro:oak_d_lite camera_name="camera_front" parent="chassis" xyz="0.16 0 -0.025" rpy="${pi} 0 0"/>

</robot>
