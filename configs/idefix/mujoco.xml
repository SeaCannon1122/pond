<mujoco>

    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".9 .4 .4" rgb2=".6 .7 .8" width="100" height="100"/>
        <material name="grid" texture="grid" texrepeat="8 8" texuniform="true" reflectance="0.06"/>
    </asset>
    
    <worldbody>

        <geom
            name="ground"
            type="plane"
            size="10 10 0.04"
            pos="0 0 0"
            rgba="1 1 1 1"
            material="grid"
            friction="1.0 0.3 0.01"
            condim="3"
        />

    </worldbody>

    <actuator>
        <position name="FR_motor" joint="FR" kp="100" kv="0.1" ctrlrange="-1 1" ctrllimited="true"/>
        <position name="BR_motor" joint="BR" kp="100" kv="0.1" ctrlrange="-1 1" ctrllimited="true"/>
        <position name="FL_motor" joint="FL" kp="100" kv="0.1" ctrlrange="-1 1" ctrllimited="true"/>
        <position name="BL_motor" joint="BL" kp="100" kv="0.1" ctrlrange="-1 1" ctrllimited="true"/>

        <position name="FR_leg_motor" joint="FR_leg" kp="100" kv="0.1" ctrlrange="-1.5 1.5" ctrllimited="true"/>
        <position name="BR_leg_motor" joint="BR_leg" kp="100" kv="0.1" ctrlrange="-1.5 1.5" ctrllimited="true"/>
        <position name="FL_leg_motor" joint="FL_leg" kp="100" kv="0.1" ctrlrange="-1.5 1.5" ctrllimited="true"/>
        <position name="BL_leg_motor" joint="BL_leg" kp="100" kv="0.1" ctrlrange="-1.5 1.5" ctrllimited="true"/>

        <position name="FR_foot_motor" joint="FR_foot" kp="100" kv="0.1" ctrlrange="-1.5 1.5" ctrllimited="true"/>
        <position name="BR_foot_motor" joint="BR_foot" kp="100" kv="0.1" ctrlrange="-1.5 1.5" ctrllimited="true"/>
        <position name="FL_foot_motor" joint="FL_foot" kp="100" kv="0.1" ctrlrange="-1.5 1.5" ctrllimited="true"/>
        <position name="BL_foot_motor" joint="BL_foot" kp="100" kv="0.1" ctrlrange="-1.5 1.5" ctrllimited="true"/>

    </actuator>
</mujoco>
